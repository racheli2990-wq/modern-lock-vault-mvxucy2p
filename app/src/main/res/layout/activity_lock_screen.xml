<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lockRootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090D16">

    <!-- Top Status Bar Area -->
    <LinearLayout
        android:id="@+id/layoutTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="horizontal"
        android:paddingTop="28dp"
        android:paddingBottom="10dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <TextView
            android:id="@+id/tvCarrier"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="PARTNER • 5G"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLockStatusIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔒"
            android:textSize="15sp"
            android:layout_marginEnd="12dp" />

        <TextView
            android:id="@+id/tvBattery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="96% 🔋"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Clock and Date Header -->
    <LinearLayout
        android:id="@+id/layoutClockSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/layoutTopBar"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginTop="20dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <TextView
            android:id="@+id/tvLockDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#DDE5ED"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvLockTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="72sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/tvLockHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/swipe_to_unlock"
            android:textColor="#B0C4DE"
            android:textSize="14sp"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <!-- Notifications Section -->
    <LinearLayout
        android:id="@+id/layoutNotifications"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/layoutClockSection"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:layout_marginTop="20dp">

        <!-- Notification 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_notification"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💬"
                android:textSize="22sp"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WhatsApp • דניאל"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="היי! נפגשים היום בשמונה? מחכה לתשובה"
                    android:textColor="#DDE5ED"
                    android:textSize="12sp"
                    android:maxLines="1" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="לפני 5 דק׳"
                android:textColor="#B0C4DE"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Notification 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_notification"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📅"
                android:textSize="22sp"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="יומן Google"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="פגישת צוות בעוד 25 דקות בחדר דיונים"
                    android:textColor="#DDE5ED"
                    android:textSize="12sp"
                    android:maxLines="1" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="עכשיו"
                android:textColor="#B0C4DE"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Biometric Fingerprint Button (Optional Mode) -->
    <LinearLayout
        android:id="@+id/layoutBiometric"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_above="@+id/layoutBottomShortcuts"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginBottom="30dp">

        <TextView
            android:id="@+id/btnFingerprint"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:gravity="center"
            android:text="🪪"
            android:textSize="38sp"
            android:background="@drawable/btn_keypad" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tap_fingerprint"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- Keypad Overlay (for PIN code) -->
    <LinearLayout
        android:id="@+id/layoutKeypad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingBottom="24dp"
        android:visibility="gone">

        <!-- PIN Dots indicator -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <View
                android:id="@+id/dot1"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_margin="6dp"
                android:background="@drawable/pin_dot_empty" />

            <View
                android:id="@+id/dot2"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_margin="6dp"
                android:background="@drawable/pin_dot_empty" />

            <View
                android:id="@+id/dot3"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_margin="6dp"
                android:background="@drawable/pin_dot_empty" />

            <View
                android:id="@+id/dot4"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_margin="6dp"
                android:background="@drawable/pin_dot_empty" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvPinError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wrong_pin"
            android:textColor="#EF4444"
            android:textSize="14sp"
            android:layout_marginBottom="12dp"
            android:visibility="invisible" />

        <!-- Row 1: 1, 2, 3 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btn1"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_margin="8dp"
                android:background="@drawable/btn_keypad"
                android:text="1"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />

            <Button
                android:id="@+id/btn2"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_margin="8dp"
                android:background="@drawable/btn_keypad"
                android:text="2"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />

            <Button
                android:id="@+id/btn3"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_margin="8dp"
                android:background="@drawable/btn_keypad"
                android:text="3"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />
        </LinearLayout>

        <!-- Row 2: 4, 5, 6 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btn4"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_margin="8dp"
                android:background="@drawable/btn_keypad"
                android:text="4"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />

            <Button
                android:id="@+id/btn5"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_margin="8dp"
                android:background="@drawable/btn_keypad"
                android:text="5"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />

            <Button
                android:id="@+id/btn6"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_margin="8dp"
                android:background="@drawable/btn_keypad"
                android:text="6"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />
        </LinearLayout>

        <!-- Row 3: 7, 8, 9 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btn7"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_margin="8dp"
                android:background="@drawable/btn_keypad"
                android:text="7"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />

            <Button
                android:id="@+id/btn8"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_margin="8dp"
                android:background="@drawable/btn_keypad"
                android:text="8"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />

            <Button
                android:id="@+id/btn9"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_margin="8dp"
                android:background="@drawable/btn_keypad"
                android:text="9"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />
        </LinearLayout>

        <!-- Row 4: Emergency, 0, Backspace -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnEmergency"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_margin="8dp"
                android:background="@drawable/btn_keypad"
                android:text="חירום"
                android:textColor="#FF6B6B"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn0"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_margin="8dp"
                android:background="@drawable/btn_keypad"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />

            <Button
                android:id="@+id/btnDelete"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_margin="8dp"
                android:background="@drawable/btn_keypad"
                android:text="⌫"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Custom Pattern Lock View Container -->
    <com.generated.app.PatternLockView
        android:id="@+id/patternLockView"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="40dp"
        android:visibility="gone" />

    <!-- Bottom Shortcuts (Torch / Camera) -->
    <RelativeLayout
        android:id="@+id/layoutBottomShortcuts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:paddingStart="36dp"
        android:paddingEnd="36dp"
        android:paddingBottom="36dp">

        <TextView
            android:id="@+id/btnTorch"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_alignParentStart="true"
            android:background="@drawable/btn_shortcut"
            android:gravity="center"
            android:text="🔦"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/btnCamera"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_alignParentEnd="true"
            android:background="@drawable/btn_shortcut"
            android:gravity="center"
            android:text="📷"
            android:textSize="24sp" />
    </RelativeLayout>

    <!-- Unlock Flash Toast Effect -->
    <TextView
        android:id="@+id/tvUnlockedNotice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:background="@drawable/bg_card_rounded"
        android:padding="20dp"
        android:text="@string/unlocked"
        android:textColor="#10B981"
        android:textSize="20sp"
        android:textStyle="bold"
        android:visibility="gone" />

</RelativeLayout>
